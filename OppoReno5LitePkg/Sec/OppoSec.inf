[Defines]
  INF_VERSION = 0x0001001B
  BASE_NAME = OppoSec
  FILE_GUID = 2bf0a605-3974-4d50-b19b-e0b1a6a4667e
  MODULE_TYPE = SEC
  VERSION_STRING = 0.1

[Sources]
  NativeMain.c

[Sources.AARCH64]
  AArch64/Entry.S

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -mgeneral-regs-only

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  ArmPkg/ArmPkg.dec
  UefiCpuPkg/UefiCpuPkg.dec
  OppoReno5LitePkg/OppoReno5LitePkg.dec

[LibraryClasses]
  ArmLib
  ArmMmuLib
  ArmSmcLib
  BaseLib
  BaseMemoryLib
  DebugLib
  PcdLib
  StackCheckLib
  HobLib
  PrePiLib
  PrePiHobListPointerLib
  OppoFdtLib
  OppoPlatformLib
  OppoHandoffLib
  OppoFrameBufferLib
  OppoMemoryPlanLib

[Guids]
  gOppoBootInfoHobGuid
  gOppoAcpiHandoffHobGuid

[FeaturePcd]
  gOppoNativeTokenSpaceGuid.PcdNativeAcpiProfileLab
  gOppoNativeTokenSpaceGuid.PcdNativeSdReadLab
  gOppoNativeTokenSpaceGuid.PcdNativeSdBootLab
  gOppoNativeTokenSpaceGuid.PcdNativeExtraMemoryLab
  gOppoNativeTokenSpaceGuid.PcdNativeEntryProbe
  gOppoNativeTokenSpaceGuid.PcdNativeMmuProbe
